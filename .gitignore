# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Build outputs ────────────────────────────────────────────────────────────
dist/
build/
**/dist/

# ─── Environment files (NEVER commit secrets) ────────────────────────────────
.env
.env.local
.env.development
.env.staging
.env.production
**/.env
**/.env.local
**/.env.production

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS generated ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── Editors ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Uploads ──────────────────────────────────────────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ─── Large / binary files ─────────────────────────────────────────────────────
postgres/
*.zip
*.exe
*.msi
*.dmg
*.pkg

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.pem
.cache
.eslintcache
coverage/
